{
	"name": "spdw-site",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev --main dist/_worker.js/index.js",
		"astro": "astro",
		"deploy": "astro build && wrangler deploy --main dist/_worker.js/index.js",
		"cf-typegen": "wrangler types",
		"type-check": "astro check && tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"knip": "knip"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.8",
		"@astrojs/cloudflare": "^13.1.10",
		"@astrojs/svelte": "^8.0.5",
		"astro": "^6.1.7",
		"chart.js": "^4.5.1",
		"postgres": "^3.4.9",
		"svelte": "^5.55.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"cloudflare": "^5.2.0",
		"eslint": "^10.2.0",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.5.0",
		"knip": "^6.4.1",
		"miniflare": "^4.20260415.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte-eslint-parser": "^1.6.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.2",
		"wrangler": "^4.83.0"
	},
	"knip": {
		"ignoreDependencies": [
			"miniflare"
		]
	},
	"pnpm": {
		"overrides": {
			"yaml@>=2.0.0 <2.8.3": ">=2.8.3",
			"@cloudflare/vite-plugin": "^1.30.2"
		}
	}
}
