---
interface Props {
	title?: string;
}

const { title = "spdw" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="spdw - stats and numbers" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="antialiased">
		<div class="min-h-screen flex flex-col">
			<main class="flex-1">
				<slot />
			</main>
			<footer class="border-t py-1 mt-2">
				<div class="content-area">
					<div class="flex justify-center items-center space-x-4 text-sm text-muted-foreground">
						<span>© spdw 2025</span>
						<a href="/about" class="about-link">
							About
						</a>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	@import "../styles/globals.css";
</style>
