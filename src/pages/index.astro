---
import Layout from '../layouts/Layout.astro';

let latestSeason: number | null = null;
try {
	const res = await fetch(new URL('/api/sel/schedule/filters', Astro.url).toString());
	if (res.ok) {
		const data = (await res.json()) as { seasons: number[] };
		const seasons = data.seasons ?? [];
		if (seasons.length > 0) latestSeason = seasons[seasons.length - 1];
	}
} catch {
	/* ignore */
}
---

<Layout title="spdw">
	<div class="p-4">
		<nav aria-label="breadcrumb">
			<ol
				class="text-muted-foreground flex flex-wrap items-center gap-1.5 text-sm break-words sm:gap-2.5"
			>
				<li class="inline-flex items-center gap-1.5">
					<span
						class="text-foreground font-normal"
						role="link"
						aria-disabled="true"
						aria-current="page"
					>
						Home
					</span>
				</li>
			</ol>
		</nav>
	</div>
	<div class="content-area">
		<h1>spdw</h1>
		<br />
		<a href="/sel" class="spdw-link">sel</a>
		<br />
		<a
			href={`/sel/results?league=PGEE${latestSeason ? `&season=${latestSeason}` : ''}`}
			class="spdw-link">results</a
		>
	</div>
</Layout>
