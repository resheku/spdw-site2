---
import Layout from '../../layouts/Layout.astro';
import MaxSpeedTable from '../../components/MaxSpeedTable.svelte';

export const prerender = false;

const urlParams = Astro.url.searchParams;
const initialSearch = urlParams.get('search') || '';
const initialTeams = urlParams.get('team')?.split(',').filter(Boolean) || [];
const initialLeagues = urlParams.get('league')?.split(',').filter(Boolean) || [];
const initialSeasons = urlParams.get('season')?.split(',').filter(Boolean) || [];
const initialTracks = urlParams.get('track')?.split(',').filter(Boolean) || [];
const initialSortColumn = urlParams.get('sortColumn') || 'Max Speed';
const initialSortDirection = urlParams.get('sortDirection') || 'desc';
const initialPage = urlParams.get('page') ? parseInt(urlParams.get('page')!) : 0;

type MaxSpeedRow = {
	Match: string;
	Season: number;
	Date: string;
	Track: string;
	Team: string;
	Rider: string;
	Heat: number | null;
	'Max Speed': number | null;
	Points: number | null;
	Gate: string | null;
	Time: number | null;
	Reaction: number | null;
	L1: number | null;
	L2: number | null;
	L3: number | null;
	L4: number | null;
};

type FilterData = {
	seasons: number[];
	teams: string[];
	tracks: string[];
	leagues: string[];
};

let initialData: MaxSpeedRow[] = [];
let initialTotal = 0;
let filterData: FilterData = { seasons: [], teams: [], tracks: [], leagues: [] };
let error: string | null = null;

try {
	const dataUrl = new URL('/api/sel/max-speeds', Astro.url);
	if (initialSearch) dataUrl.searchParams.set('search', initialSearch);
	if (initialTeams.length > 0) dataUrl.searchParams.set('team', initialTeams.join(','));
	if (initialLeagues.length > 0) dataUrl.searchParams.set('league', initialLeagues.join(','));
	if (initialSeasons.length > 0) dataUrl.searchParams.set('season', initialSeasons.join(','));
	if (initialTracks.length > 0) dataUrl.searchParams.set('track', initialTracks.join(','));
	dataUrl.searchParams.set('sortColumn', initialSortColumn);
	dataUrl.searchParams.set('sortDirection', initialSortDirection);
	dataUrl.searchParams.set('page', String(initialPage));

	const [dataRes, filtersRes] = await Promise.all([
		fetch(dataUrl.toString()),
		fetch(new URL('/api/sel/max-speeds/filters', Astro.url).toString()),
	]);

	if (dataRes.ok && filtersRes.ok) {
		const dataJson = (await dataRes.json()) as {
			rows: MaxSpeedRow[];
			total: number;
			page: number;
			pageSize: number;
		};
		initialData = dataJson.rows ?? [];
		initialTotal = dataJson.total ?? 0;
		filterData = (await filtersRes.json()) as FilterData;
	} else {
		error = 'Failed to load max speed data';
	}
} catch (err) {
	console.error('Error fetching max speeds:', err);
	error = 'Failed to load max speed data';
}
---

<Layout title="SEL Max Speeds - spdw">
	<div class="p-4">
		<nav aria-label="breadcrumb">
			<ol
				class="text-muted-foreground flex flex-wrap items-center gap-1.5 text-sm break-words sm:gap-2.5"
			>
				<li class="inline-flex items-center gap-1.5">
					<a href="/" class="hover:text-foreground transition-colors">Home</a>
				</li>
				<li role="presentation" aria-hidden="true" class="[&>svg]:size-3.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m9 18 6-6-6-6"></path>
					</svg>
				</li>
				<li class="inline-flex items-center gap-1.5">
					<a href="/sel" class="hover:text-foreground transition-colors">sel</a>
				</li>
				<li role="presentation" aria-hidden="true" class="[&>svg]:size-3.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m9 18 6-6-6-6"></path>
					</svg>
				</li>
				<li class="inline-flex items-center gap-1.5">
					<span
						class="text-foreground font-normal"
						role="link"
						aria-disabled="true"
						aria-current="page">max speeds</span
					>
				</li>
			</ol>
		</nav>
	</div>

	<div class="max-w-full px-4 pb-8">
		<h1 class="mb-6 text-2xl font-bold">SEL Max Speeds</h1>

		{
			error ? (
				<div class="bg-muted text-muted-foreground rounded-md p-4">
					<p>{error}</p>
				</div>
			) : (
				<MaxSpeedTable
					client:load
					initialData={initialData}
					initialTotal={initialTotal}
					initialPage={initialPage}
					filterData={filterData}
					initialSearch={initialSearch}
					initialTeams={initialTeams}
					initialSeasons={initialSeasons}
					initialTracks={initialTracks}
					initialSortColumn={initialSortColumn}
					initialSortDirection={initialSortDirection}
				/>
			)
		}
	</div>
</Layout>
