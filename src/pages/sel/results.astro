---
import Layout from '../../layouts/Layout.astro';
import ScheduleTable from '../../components/ScheduleTable.svelte';

export const prerender = false;

const urlParams = Astro.url.searchParams;
const initialLeagues = urlParams.get('league')?.split(',').filter(Boolean) ?? [];
const initialSeasons = urlParams.get('season')?.split(',').filter(Boolean) ?? [];
const initialRounds = urlParams.get('round')?.split(',').filter(Boolean) ?? [];
const initialTracks = urlParams.get('track')?.split(',').filter(Boolean) ?? [];
const initialTeams = urlParams.get('team')?.split(',').filter(Boolean) ?? [];
const initialSortColumns = urlParams.get('sortColumn')?.split(',').filter(Boolean) ?? [];
const initialSortDirections = urlParams.get('sortDirection')?.split(',').filter(Boolean) ?? [];

type ScheduleRow = {
	match_id: number;
	round: number | null;
	league: string | null;
	leagueName: string | null;
	type: string | null;
	typeName: string | null;
	datetime: string | null;
	matchName: string | null;
	homeTeamId: number | null;
	homeTeamShort: string | null;
	awayTeamId: number | null;
	awayTeamShort: string | null;
	homeScore: number | null;
	awayScore: number | null;
	homeTotal: number | null;
	awayTotal: number | null;
	attendance: number | null;
	season: number | null;
	track: string | null;
};

let schedule: ScheduleRow[] = [];
let allLeagues: Array<{ shortname: string; name: string }> = [];
let allSeasons: number[] = [];
let error: string | null = null;

try {
	const [scheduleRes, filtersRes] = await Promise.all([
		fetch(new URL('/api/sel/schedule?sortColumn=date&sortDirection=desc', Astro.url).toString()),
		fetch(new URL('/api/sel/schedule/filters', Astro.url).toString()),
	]);

	if (scheduleRes.ok && filtersRes.ok) {
		schedule = ((await scheduleRes.json()) as { schedule: ScheduleRow[] }).schedule ?? [];
		const fd = (await filtersRes.json()) as {
			leagues: Array<{ shortname: string; name: string }>;
			seasons: number[];
		};
		allLeagues = fd.leagues ?? [];
		allSeasons = fd.seasons ?? [];
	} else {
		error = 'Failed to load schedule';
	}
} catch (err) {
	console.error('[results page] Error:', err);
	error = 'Failed to load results';
}
---

<Layout title="SEL Results - spdw">
	<div class="p-4">
		<nav aria-label="breadcrumb">
			<ol
				class="text-muted-foreground flex flex-wrap items-center gap-1.5 text-sm break-words sm:gap-2.5"
			>
				<li class="inline-flex items-center gap-1.5">
					<a href="/" class="hover:text-foreground transition-colors">Home</a>
				</li>
				<li role="presentation" aria-hidden="true" class="[&>svg]:size-3.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m9 18 6-6-6-6"></path>
					</svg>
				</li>
				<li class="inline-flex items-center gap-1.5">
					<a href="/sel" class="hover:text-foreground transition-colors">sel</a>
				</li>
				<li role="presentation" aria-hidden="true" class="[&>svg]:size-3.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="m9 18 6-6-6-6"></path>
					</svg>
				</li>
				<li class="inline-flex items-center gap-1.5">
					<span
						class="text-foreground font-normal"
						role="link"
						aria-disabled="true"
						aria-current="page">results</span
					>
				</li>
			</ol>
		</nav>
	</div>

	<div class="max-w-full px-4 pb-8">
		<h1 class="mb-6 text-2xl font-bold">SEL Results</h1>

		{
			error ? (
				<div class="bg-muted text-muted-foreground rounded-md p-4">
					<p>{error}</p>
				</div>
			) : (
				<ScheduleTable
					client:load
					initialData={schedule}
					allLeagues={allLeagues}
					allSeasons={allSeasons}
					initialLeagues={initialLeagues}
					initialSeasons={initialSeasons}
					initialRounds={initialRounds}
					initialTracks={initialTracks}
					initialTeams={initialTeams}
					initialSortColumns={initialSortColumns}
					initialSortDirections={initialSortDirections}
				/>
			)
		}
	</div>
</Layout>
