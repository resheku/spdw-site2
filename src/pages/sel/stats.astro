						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-lg:hidden" data-column="Bonus" data-column-id="bonus">Bon<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-sm:hidden" data-column="Home Avg." data-column-id="home">Home<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-sm:hidden" data-column="Away Avg." data-column-id="away">Away<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="I" data-column-id="i">I<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="II" data-column-id="ii">II<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="III" data-column-id="iii">III<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="IV" data-column-id="iv">IV<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="R" data-column-id="r">R<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="T" data-column-id="t">T<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="M" data-column-id="m">M<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80 max-xl:hidden" data-column="X" data-column-id="x">X<span class="sort-indicator"></span>
