		{error && (
			<div class="mt-4 p-4 bg-muted rounded-md text-muted-foreground">
				<p>{error}</p>
			</div>
		)}
	</div>

	<!-- Pass initial data to client-side script -->
	<script define:vars={{ initialStats: stats, initialHasAllData: initialTeams.length === 0 && initialLeagues.length === 0 && initialSeasons.length === 0, filterMapping: filterMapping, initialTeams: initialTeams, initialLeagues: initialLeagues, initialSeasons: initialSeasons }}>
		window.__INITIAL_STATS__ = initialStats;
		window.__HAS_ALL_DATA__ = initialHasAllData;
		window.__FILTER_MAPPING__ = filterMapping;
		window.__INITIAL_TEAMS__ = initialTeams;
		window.__INITIAL_LEAGUES__ = initialLeagues;
		window.__INITIAL_SEASONS__ = initialSeasons;
	</script>
</Layout>

<script>
	// Current filter and sort state
	let currentFilters = {
		search: '',
		teams: [] as string[],
		leagues: [] as string[],
		seasons: [] as string[],
		sortColumn: '',
		sortDirection: ''
	};
	let debounceTimer: number;
	let isLoading = false;

	// Cache to store data for different filter combinations
	// Key format: "team1,team2:league1,league2:season1,season2"
	const dataCache = new Map<string, any[]>();
	let totalDataCount = 0;

	// Get the filter mapping from the window
	const filterMapping = (window as any).__FILTER_MAPPING__;

	// Helper to create cache key from filters
	function getCacheKey(teams: string[], leagues: string[], seasons: string[]): string {
		return `${teams.sort().join(',')}:${leagues.sort().join(',')}:${seasons.sort().join(',')}`;
	}

	// Update dropdown options based on current filter selections
	function updateDropdownOptions() {
		if (!filterMapping) return;

		const currentTeams = currentFilters.teams;
		const currentLeagues = currentFilters.leagues;
		const currentSeasons = currentFilters.seasons;

		// Always show all available options
		const availableTeams = filterMapping.all?.teams || [];
		const availableLeagues = filterMapping.all?.leagues || [];
		const availableSeasons = filterMapping.all?.seasons || [];

		// Render the options
		renderFilterOptions('team', availableTeams, currentTeams);
		renderFilterOptions('league', availableLeagues, currentLeagues);
		renderFilterOptions('season', availableSeasons.map(String), currentSeasons);

		// Update button labels
		updateFilterButtonLabel('team', currentTeams);
		updateFilterButtonLabel('league', currentLeagues);
		updateFilterButtonLabel('season', currentSeasons);
	}

	// Render filter options with checkboxes and links
	function renderFilterOptions(filterType: string, options: string[], selectedValues: string[]) {
		const container = document.getElementById(`${filterType}FilterOptions`);
		if (!container) return;

		container.innerHTML = '';

		options.forEach(option => {
			const isChecked = selectedValues.includes(option);
			
			const itemDiv = document.createElement('div');
			itemDiv.className = 'flex items-center gap-2 py-1 hover:bg-muted/50 rounded px-1';
			
			// Checkbox
			const checkbox = document.createElement('input');
			checkbox.type = 'checkbox';
			checkbox.id = `${filterType}-${option}`;
			checkbox.value = option;
			checkbox.checked = isChecked;
			checkbox.className = 'cursor-pointer';
			checkbox.addEventListener('change', (e) => {
				handleCheckboxChange(filterType, option, (e.target as HTMLInputElement).checked);
			});
			
			// Link label
			const link = document.createElement('a');
			link.href = '#';
			link.textContent = option;
			link.className = 'flex-1 text-sm hover:underline cursor-pointer';
			link.addEventListener('click', (e) => {
				e.preventDefault();
				handleLinkClick(filterType, option);
			});
			
			itemDiv.appendChild(checkbox);
			itemDiv.appendChild(link);
			container.appendChild(itemDiv);
		});
	}

	// Update filter button label to show selected count
	function updateFilterButtonLabel(filterType: string, selectedValues: string[]) {
		const label = document.getElementById(`${filterType}FilterLabel`);
		if (!label) return;

		const filterName = filterType.charAt(0).toUpperCase() + filterType.slice(1) + 's';
		
		if (selectedValues.length === 0) {
			label.textContent = filterName;
		} else if (selectedValues.length === 1) {
			label.textContent = selectedValues[0];
		} else {
			label.textContent = `${filterName} (${selectedValues.length})`;
		}
		
		// Update clear button state
		const clearBtn = document.getElementById(`${filterType}ClearBtn`) as HTMLButtonElement;
		if (clearBtn) {
			clearBtn.disabled = selectedValues.length === 0;
		}
	}

	// Handle checkbox change
	function handleCheckboxChange(filterType: string, value: string, checked: boolean) {
		const filterKey = `${filterType}s` as 'teams' | 'leagues' | 'seasons';
		
		if (checked) {
			if (!currentFilters[filterKey].includes(value)) {
				currentFilters[filterKey].push(value);
			}
		} else {
			currentFilters[filterKey] = currentFilters[filterKey].filter(v => v !== value);
		}
		
		updateFilterButtonLabel(filterType, currentFilters[filterKey]);
		updateDropdownOptions();
		updateURL();
		applyFiltersAndSort();
	}

	// Handle link click (select only this item)
	function handleLinkClick(filterType: string, value: string) {
		const filterKey = `${filterType}s` as 'teams' | 'leagues' | 'seasons';
		currentFilters[filterKey] = [value];
		
		// Close the dropdown
		const dropdown = document.getElementById(`${filterType}FilterDropdown`);
		if (dropdown) {
			dropdown.classList.add('hidden');
		}
		
		updateFilterButtonLabel(filterType, currentFilters[filterKey]);
		updateDropdownOptions();
		updateURL();
		applyFiltersAndSort();
	}

	// Check if cached data is a superset of requested filters
	// Returns the cached data if it contains all rows we need, null otherwise
	function findSupersetInCache(): any[] | null {
		// For multi-select, we need exact match or all data
		const target = {
			teams: currentFilters.teams,
			leagues: currentFilters.leagues,
			seasons: currentFilters.seasons
		};

		// Check for exact match
		const exactKey = getCacheKey(target.teams, target.leagues, target.seasons);
		if (dataCache.has(exactKey)) {
			return dataCache.get(exactKey)!;
		}

		// Check if we have all data cached
		const allDataKey = getCacheKey([], [], []);
		if (dataCache.has(allDataKey)) {
			return dataCache.get(allDataKey)!;
		}

		return null;
	}

	// Initialize from URL params
	function initializeFromURL() {
		const urlParams = new URLSearchParams(window.location.search);
		currentFilters.search = urlParams.get('search') || '';
		currentFilters.teams = urlParams.get('team')?.split(',').filter(Boolean) || [];
		currentFilters.leagues = urlParams.get('league')?.split(',').filter(Boolean) || [];
		currentFilters.seasons = urlParams.get('season')?.split(',').filter(Boolean) || [];
		currentFilters.sortColumn = urlParams.get('sortColumn') || '';
		currentFilters.sortDirection = urlParams.get('sortDirection') || '';

		// Get initial data from window and cache it
		if ((window as any).__INITIAL_STATS__) {
			const initialData = (window as any).__INITIAL_STATS__;
			const initialTeams = (window as any).__INITIAL_TEAMS__ || [];
			const initialLeagues = (window as any).__INITIAL_LEAGUES__ || [];
			const initialSeasons = (window as any).__INITIAL_SEASONS__ || [];
			const cacheKey = getCacheKey(initialTeams, initialLeagues, initialSeasons);
			dataCache.set(cacheKey, initialData);
			
			// If we loaded all data, set totalDataCount
			if ((window as any).__HAS_ALL_DATA__) {
				totalDataCount = initialData.length;
			}
		}

		// Update sort indicators if sorting is active
		if (currentFilters.sortColumn) {
			updateSortIndicators();
		}
	}

	// Update URL with current filter state
	function updateURL() {
		const params = new URLSearchParams();
		if (currentFilters.search) params.set('search', currentFilters.search);
		if (currentFilters.teams.length > 0) params.set('team', currentFilters.teams.join(','));
		if (currentFilters.leagues.length > 0) params.set('league', currentFilters.leagues.join(','));
		if (currentFilters.seasons.length > 0) params.set('season', currentFilters.seasons.join(','));
		if (currentFilters.sortColumn) params.set('sortColumn', currentFilters.sortColumn);
		if (currentFilters.sortDirection) params.set('sortDirection', currentFilters.sortDirection);

		const newURL = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
		window.history.pushState({}, '', newURL);
	}

	// Initialize
	document.addEventListener('DOMContentLoaded', () => {
		// Initialize state from URL
		initializeFromURL();

		// Initialize dropdown options
		updateDropdownOptions();

		// Setup search with debounce
		const searchInput = document.getElementById('searchInput') as HTMLInputElement;
		searchInput?.addEventListener('input', (e) => {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(() => {
				currentFilters.search = (e.target as HTMLInputElement).value;
				updateURL();
				applyFiltersAndSort();
			}, 300);
		});

		// Setup filter dropdown toggles
		const teamFilterBtn = document.getElementById('teamFilterBtn');
		const leagueFilterBtn = document.getElementById('leagueFilterBtn');
		const seasonFilterBtn = document.getElementById('seasonFilterBtn');

		teamFilterBtn?.addEventListener('click', () => toggleDropdown('team'));
		leagueFilterBtn?.addEventListener('click', () => toggleDropdown('league'));
		seasonFilterBtn?.addEventListener('click', () => toggleDropdown('season'));

		// Close dropdowns when clicking outside
		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (!target.closest('.relative')) {
				closeAllDropdowns();
			}
		});

		// Setup clear buttons
		document.querySelectorAll('[data-action="clear"]').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const filterType = (btn as HTMLElement).dataset.filter;
				if (filterType) handleClear(filterType);
			});
		});

		// Setup sorting
		const sortableHeaders = document.querySelectorAll('.sortable');
		sortableHeaders.forEach(header => {
			header.addEventListener('click', handleSort);
		});
	});

	// Toggle dropdown visibility
	function toggleDropdown(filterType: string) {
		const dropdown = document.getElementById(`${filterType}FilterDropdown`);
		if (!dropdown) return;

		const isHidden = dropdown.classList.contains('hidden');
		
		// Close all dropdowns first
		closeAllDropdowns();
		
		// Toggle this dropdown
		if (isHidden) {
			dropdown.classList.remove('hidden');
		}
	}

	// Close all dropdowns
	function closeAllDropdowns() {
		document.getElementById('teamFilterDropdown')?.classList.add('hidden');
		document.getElementById('leagueFilterDropdown')?.classList.add('hidden');
		document.getElementById('seasonFilterDropdown')?.classList.add('hidden');
	}

	// Handle clear (deselect all items)
	function handleClear(filterType: string) {
		const filterKey = `${filterType}s` as 'teams' | 'leagues' | 'seasons';
		const container = document.getElementById(`${filterType}FilterOptions`);
		if (!container) return;

		// Get all checkboxes and uncheck them
		const checkboxes = container.querySelectorAll('input[type="checkbox"]') as NodeListOf<HTMLInputElement>;
		
		checkboxes.forEach(checkbox => {
			checkbox.checked = false;
		});

		currentFilters[filterKey] = [];
		updateFilterButtonLabel(filterType, []);
		updateDropdownOptions();
		updateURL();
		applyFiltersAndSort();
	}

	async function applyFiltersAndSort() {
		// Check if we have cached data that contains what we need
		const cachedData = findSupersetInCache();

		if (cachedData) {
			// Use cached data - filter and sort client-side
			filterAndSortClientSide(cachedData);
		} else {
			// Fetch from API and cache the result
			await fetchStats();
		}
	}

	function filterAndSortClientSide(sourceData: any[]) {
		let filteredData = [...sourceData];

		// Apply team filter (client-side)
		if (currentFilters.teams.length > 0) {
			filteredData = filteredData.filter(stat => currentFilters.teams.includes(stat.Team));
		}

		// Apply league filter (client-side)
		if (currentFilters.leagues.length > 0) {
			filteredData = filteredData.filter(stat => currentFilters.leagues.includes(stat.League));
		}

		// Apply season filter (client-side)
		if (currentFilters.seasons.length > 0) {
			filteredData = filteredData.filter(stat => 
				currentFilters.seasons.includes(stat.Season.toString())
			);
		}

		// Apply search filter (client-side)
		if (currentFilters.search) {
			const searchLower = currentFilters.search.toLowerCase();
			filteredData = filteredData.filter(stat => 
				stat.Name.toLowerCase().includes(searchLower)
			);
		}

		// Apply sorting
		if (currentFilters.sortColumn) {
			const column = currentFilters.sortColumn;
			const direction = currentFilters.sortDirection === 'asc' ? 1 : -1;

			filteredData.sort((a: any, b: any) => {
				let aVal = a[column];
				let bVal = b[column];

				// Handle null/undefined values - always put them at the bottom
				if (aVal == null || aVal === '-' || aVal === '') {
					return 1; // a goes to bottom
				}
				if (bVal == null || bVal === '-' || bVal === '') {
					return -1; // b goes to bottom
				}

				// Compare values
				if (typeof aVal === 'string') {
					return direction * aVal.localeCompare(bVal);
				} else {
					return direction * (aVal - bVal);
				}
			});
		}

		// Update table with filtered/sorted data
		updateTable(filteredData);
		updateResultCount(filteredData.length);
	}

	async function fetchStats() {
		if (isLoading) return;
		isLoading = true;

		// Build query string (excluding search - that's client-side only)
		const params = new URLSearchParams();
		if (currentFilters.teams.length > 0) params.set('team', currentFilters.teams.join(','));
		if (currentFilters.leagues.length > 0) params.set('league', currentFilters.leagues.join(','));
		if (currentFilters.seasons.length > 0) params.set('season', currentFilters.seasons.join(','));
		// Note: We don't send search, sortColumn, sortDirection to API
		// Those will be applied client-side

		try {
			const response = await fetch(`/api/sel/stats?${params.toString()}`);
			if (!response.ok) {
				throw new Error('Failed to fetch stats');
			}

			const data = await response.json();
			
			// Cache the fetched data
			const cacheKey = getCacheKey(currentFilters.teams, currentFilters.leagues, currentFilters.seasons);
			dataCache.set(cacheKey, data.stats);
			
			// If this is all data (no filters), update totalDataCount
			if (currentFilters.teams.length === 0 && currentFilters.leagues.length === 0 && currentFilters.seasons.length === 0) {
				totalDataCount = data.stats.length;
			}
			
			// Now apply search and sort client-side
			filterAndSortClientSide(data.stats);
		} catch (error) {
			console.error('Error fetching stats:', error);
		} finally {
			isLoading = false;
		}
	}

	function updateTable(stats: any[]) {
		const tbody = document.getElementById('statsBody');
		if (!tbody) return;

		// Clear existing rows
		tbody.innerHTML = '';

		// Add new rows
		stats.forEach((stat: any) => {
			const row = document.createElement('tr');
			row.className = 'border-t border-border hover:bg-muted/50';
			row.innerHTML = `
				<td class="px-3 py-2 text-left">${stat.Season || ''}</td>
				<td class="px-3 py-2 text-left font-medium">${stat.Name || ''}</td>
				<td class="px-3 py-2 text-left">${stat.Team || ''}</td>
				<td class="px-3 py-2 text-right">${stat.Average ? stat.Average.toFixed(3) : '-'}</td>
				<td class="px-3 py-2 text-right">${stat.Match || 0}</td>
				<td class="px-3 py-2 text-right">${stat.Heats || 0}</td>
				<td class="px-3 py-2 text-right">${stat.Points || 0}</td>
				<td class="px-3 py-2 text-right">${stat.Bonus || 0}</td>
				<td class="px-3 py-2 text-right">${stat['Home Avg.'] ? stat['Home Avg.'].toFixed(3) : '-'}</td>
				<td class="px-3 py-2 text-right">${stat['Away Avg.'] ? stat['Away Avg.'].toFixed(3) : '-'}</td>
				<td class="px-3 py-2 text-right">${stat.I || 0}</td>
				<td class="px-3 py-2 text-right">${stat.II || 0}</td>
				<td class="px-3 py-2 text-right">${stat.III || 0}</td>
				<td class="px-3 py-2 text-right">${stat.IV || 0}</td>
				<td class="px-3 py-2 text-right">${stat.R || 0}</td>
				<td class="px-3 py-2 text-right">${stat.T || 0}</td>
				<td class="px-3 py-2 text-right">${stat.M || 0}</td>
				<td class="px-3 py-2 text-right">${stat.X || 0}</td>
				<td class="px-3 py-2 text-right">${stat.F || 0}</td>
				<td class="px-3 py-2 text-right">${stat.Warn || 0}</td>
				<td class="px-3 py-2 text-right">${stat['Max Speed'] ? stat['Max Speed'].toFixed(2) : '-'}</td>
				<td class="px-3 py-2 text-left">${stat.League || ''}</td>
			`;
			tbody.appendChild(row);
		});
	}

	function updateResultCount(count: number) {
		const resultCount = document.getElementById('resultCount');
		if (resultCount) {
			resultCount.textContent = count.toString();
		}
		
		// Update total count for "X of Y" display
		const allDataKey = getCacheKey([], [], []);
		const hasAllData = dataCache.has(allDataKey);
		const currentCacheKey = getCacheKey(currentFilters.teams, currentFilters.leagues, currentFilters.seasons);
		const currentData = dataCache.get(currentCacheKey);
		const totalCount = currentData ? currentData.length : count;
		
		const totalElement = resultCount?.parentElement;
		if (totalElement) {
			totalElement.innerHTML = `Showing <span id="resultCount">${count}</span> of ${totalCount} results`;
		}
	}

	function updateSortIndicators() {
		// Clear all indicators
		document.querySelectorAll('.sort-indicator').forEach(indicator => {
			indicator.textContent = '';
		});

		// Set active indicator
		if (currentFilters.sortColumn) {
			const header = document.querySelector(`[data-column="${currentFilters.sortColumn}"]`);
			const indicator = header?.querySelector('.sort-indicator');
			if (indicator) {
				indicator.textContent = currentFilters.sortDirection === 'desc' ? ' ▼' : ' ▲';
			}
		}
	}

	function handleSort(event: Event) {
		const header = event.currentTarget as HTMLElement;
		const column = header.dataset.column;
		if (!column) return;

		// Toggle sort direction: none -> desc -> asc -> none
		if (currentFilters.sortColumn === column) {
			if (currentFilters.sortDirection === 'desc') {
				currentFilters.sortDirection = 'asc';
			} else if (currentFilters.sortDirection === 'asc') {
				currentFilters.sortColumn = '';
				currentFilters.sortDirection = '';
			}
		} else {
			currentFilters.sortColumn = column;
			currentFilters.sortDirection = 'desc';
		}

		updateSortIndicators();
		updateURL();
		applyFiltersAndSort();
	}
</script>

<style>
	.sort-indicator {
		display: inline-block;
		width: 1em;
		text-align: center;
		font-size: 0.75em;
		opacity: 0.7;
	}
</style>
