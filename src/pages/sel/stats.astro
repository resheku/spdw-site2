---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

// Read URL params for initial state
const urlParams = Astro.url.searchParams;
const initialSearch = urlParams.get('search') || '';
const initialTeams = urlParams.get('team')?.split(',').filter(Boolean) || [];
const initialLeagues = urlParams.get('league')?.split(',').filter(Boolean) || [];
const initialSeasons = urlParams.get('season')?.split(',').filter(Boolean) || [];
const initialHeatsMin = urlParams.get('heatsMin') ? parseInt(urlParams.get('heatsMin')!) : null;
const initialHeatsMax = urlParams.get('heatsMax') ? parseInt(urlParams.get('heatsMax')!) : null;
const initialSortColumns = urlParams.get('sortColumn')?.split(',').filter(Boolean) || [];
const initialSortDirections = urlParams.get('sortDirection')?.split(',').filter(Boolean) || [];

// Fetch initial data from API endpoints with URL params
let stats: any[] = [];
let filterMapping: any = null;
let teams: string[] = [];
let leagues: string[] = [];
let seasons: number[] = [];
let error: string | null = null;

try {
	// Build stats URL with query params
	const statsUrl = new URL('/api/sel/stats', Astro.url);
	if (initialSearch) statsUrl.searchParams.set('search', initialSearch);
	if (initialTeams.length > 0) statsUrl.searchParams.set('team', initialTeams.join(','));
	if (initialLeagues.length > 0) statsUrl.searchParams.set('league', initialLeagues.join(','));
	if (initialSeasons.length > 0) statsUrl.searchParams.set('season', initialSeasons.join(','));
	if (initialSortColumns.length > 0) {
		statsUrl.searchParams.set('sortColumn', initialSortColumns.join(','));
		statsUrl.searchParams.set('sortDirection', initialSortDirections.join(','));
	}

	// Build filters URL with query params (for heats range calculation)
	const filtersUrl = new URL('/api/sel/stats/filters', Astro.url);
	if (initialTeams.length > 0) filtersUrl.searchParams.set('team', initialTeams.join(','));
	if (initialLeagues.length > 0) filtersUrl.searchParams.set('league', initialLeagues.join(','));
	if (initialSeasons.length > 0) filtersUrl.searchParams.set('season', initialSeasons.join(','));

	// Fetch stats and filter options in parallel
	const [statsResponse, filtersResponse] = await Promise.all([
		fetch(statsUrl.toString()),
		fetch(filtersUrl.toString())
	]);
	
	if (statsResponse.ok && filtersResponse.ok) {
		const statsData = await statsResponse.json();
		filterMapping = await filtersResponse.json();
		
		stats = statsData.stats || [];
		teams = filterMapping.all?.teams || [];
		leagues = filterMapping.all?.leagues || [];
		seasons = filterMapping.all?.seasons || [];
	} else {
		error = 'Failed to load stats';
	}
} catch (err) {
	console.error('Error fetching stats:', err);
	error = 'Failed to load stats';
}
---

