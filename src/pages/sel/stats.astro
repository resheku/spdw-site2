						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80" data-column="T">T<span class="sort-indicator"></span>
						</th>
						<th class="sortable px-0 py-2 text-right font-medium cursor-pointer hover:bg-muted/80" data-column="M">M<span class="sort-indicator"></span>
						</th>
