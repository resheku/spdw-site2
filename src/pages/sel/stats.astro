							<td class="px-2 py-2 text-right text-muted-foreground" data-column-id="rank">{index + 1}</td>
							<td class="px-3 py-2 text-left font-medium" data-column-id="name">{stat.Name}</td>
							<td class="px-3 py-2 text-left" data-column-id="team">{stat.Team}</td>
							<td class="px-3 py-2 text-right" data-column-id="average">{stat.Average?.toFixed(3) || '-'}</td>
							<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="match">{stat.Match || 0}</td>
							<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="heats">{stat.Heats || 0}</td>
							<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="points">{stat.Points || 0}</td>
							<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="bonus">{stat.Bonus || 0}</td>
							<td class="px-3 py-2 text-right max-sm:hidden" data-column-id="home">{stat['Home Avg.']?.toFixed(3) || '-'}</td>
							<td class="px-3 py-2 text-right max-sm:hidden" data-column-id="away">{stat['Away Avg.']?.toFixed(3) || '-'}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="i">{stat.I || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="ii">{stat.II || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="iii">{stat.III || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="iv">{stat.IV || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="r">{stat.R || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="t">{stat.T || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="m">{stat.M || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="x">{stat.X || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="f">{stat.F || 0}</td>
							<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="warn">{stat.Warn || 0}</td>
							<td class="px-3 py-2 text-right max-md:hidden" data-column-id="maxspeed">{stat['Max Speed']?.toFixed(2) || '-'}</td>
							<td class="px-3 py-2 text-left max-md:hidden" data-column-id="league">{stat.League}</td>
							<td class="px-3 py-2 text-left max-md:hidden" data-column-id="season">{stat.Season}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		{error && (
			<div class="mt-4 p-4 bg-muted rounded-md text-muted-foreground">
				<p>{error}</p>
			</div>
		)}
	</div>

	<!-- Pass initial data to client-side script -->
	<script define:vars={{ initialStats: stats, initialHasAllData: initialTeams.length === 0 && initialLeagues.length === 0 && initialSeasons.length === 0, filterMapping: filterMapping, initialTeams: initialTeams, initialLeagues: initialLeagues, initialSeasons: initialSeasons, initialHeatsMin: initialHeatsMin, initialHeatsMax: initialHeatsMax }}>
		window.__INITIAL_STATS__ = initialStats;
		window.__HAS_ALL_DATA__ = initialHasAllData;
		window.__FILTER_MAPPING__ = filterMapping;
		window.__INITIAL_TEAMS__ = initialTeams;
		window.__INITIAL_LEAGUES__ = initialLeagues;
		window.__INITIAL_SEASONS__ = initialSeasons;
		window.__INITIAL_HEATS_MIN__ = initialHeatsMin;
		window.__INITIAL_HEATS_MAX__ = initialHeatsMax;
	</script>
</Layout>

<script>
	// Current filter and sort state
	let currentFilters = {
		search: '',
		teams: [] as string[],
		leagues: [] as string[],
		seasons: [] as string[],
		heatsMin: null as number | null,
		heatsMax: null as number | null,
		sortColumns: [] as Array<{ column: string, direction: string }>
	};
	let debounceTimer: number;
	let isLoading = false;

	// Initialize heats range state
	let heatsRangeMin = 0;
	let heatsRangeMax = 100;
	let isDraggingMin = false;
	let isDraggingMax = false;

	// Column visibility state
	const COLUMN_STORAGE_KEY = 'sel-stats-column-visibility';
	const COLUMN_OVERRIDE_KEY = 'sel-stats-column-overrides';
	const columns = [
		{ id: 'rank', label: '#', alwaysVisible: true },
		{ id: 'name', label: 'Name', alwaysVisible: true },
		{ id: 'team', label: 'Team', alwaysVisible: true },
		{ id: 'average', label: 'Average', alwaysVisible: true },
		{ id: 'match', label: 'M (Match)', responsiveClass: 'max-lg:hidden' },
		{ id: 'heats', label: 'H (Heats)', responsiveClass: 'max-lg:hidden' },
		{ id: 'points', label: 'Pts (Points)', responsiveClass: 'max-lg:hidden' },
		{ id: 'bonus', label: 'Bon (Bonus)', responsiveClass: 'max-lg:hidden' },
		{ id: 'home', label: 'Home Avg.', responsiveClass: 'max-sm:hidden' },
		{ id: 'away', label: 'Away Avg.', responsiveClass: 'max-sm:hidden' },
		{ id: 'i', label: 'I', responsiveClass: 'max-xl:hidden' },
		{ id: 'ii', label: 'II', responsiveClass: 'max-xl:hidden' },
		{ id: 'iii', label: 'III', responsiveClass: 'max-xl:hidden' },
		{ id: 'iv', label: 'IV', responsiveClass: 'max-xl:hidden' },
		{ id: 'r', label: 'R', responsiveClass: 'max-xl:hidden' },
		{ id: 't', label: 'T', responsiveClass: 'max-xl:hidden' },
		{ id: 'm', label: 'M', responsiveClass: 'max-xl:hidden' },
		{ id: 'x', label: 'X', responsiveClass: 'max-xl:hidden' },
		{ id: 'f', label: 'F', responsiveClass: 'max-xl:hidden' },
		{ id: 'warn', label: 'W (Warn)', responsiveClass: 'max-xl:hidden' },
		{ id: 'maxspeed', label: 'Mx Speed', responsiveClass: 'max-md:hidden' },
		{ id: 'league', label: 'League', responsiveClass: 'max-md:hidden' },
		{ id: 'season', label: 'Season', responsiveClass: 'max-md:hidden' }
	];
	let columnVisibility: Record<string, boolean> = {};
	let columnOverrides: Record<string, 'show' | 'hide' | null> = {}; // Track manual overrides

	// Cache to store data for different filter combinations
	// Key format: "team1,team2:league1,league2:season1,season2"
	const dataCache = new Map<string, any[]>();
	let totalDataCount = 0;

	// Get the filter mapping from the window
	const filterMapping = (window as any).__FILTER_MAPPING__;

	// Helper to create cache key from filters
	function getCacheKey(teams: string[], leagues: string[], seasons: string[]): string {
		return `${teams.sort().join(',')}:${leagues.sort().join(',')}:${seasons.sort().join(',')}`;
	}

	// Column visibility functions
	function loadColumnVisibility() {
		try {
			const stored = localStorage.getItem(COLUMN_STORAGE_KEY);
			const storedOverrides = localStorage.getItem(COLUMN_OVERRIDE_KEY);
			
			if (stored) {
				columnVisibility = JSON.parse(stored);
			} else {
				// Default: all columns visible
				columns.forEach(col => {
					columnVisibility[col.id] = true;
				});
			}
			
			if (storedOverrides) {
				columnOverrides = JSON.parse(storedOverrides);
			} else {
				// Default: no overrides
				columns.forEach(col => {
					columnOverrides[col.id] = null;
				});
			}
		} catch (e) {
			// Default: all columns visible, no overrides
			columns.forEach(col => {
				columnVisibility[col.id] = true;
				columnOverrides[col.id] = null;
			});
		}
	}

	function saveColumnVisibility() {
		try {
			localStorage.setItem(COLUMN_STORAGE_KEY, JSON.stringify(columnVisibility));
			localStorage.setItem(COLUMN_OVERRIDE_KEY, JSON.stringify(columnOverrides));
		} catch (e) {
			console.error('Failed to save column visibility:', e);
		}
	}

	function toggleColumn(columnId: string, visible: boolean) {
		columnVisibility[columnId] = visible;
		// Mark this as a manual override
		columnOverrides[columnId] = visible ? 'show' : 'hide';
		saveColumnVisibility();
		applyColumnVisibility();
	}

	function applyColumnVisibility() {
		columns.forEach(col => {
			const cells = document.querySelectorAll(`[data-column-id="${col.id}"]`);
			const override = columnOverrides[col.id];
			
			cells.forEach(cell => {
				// Remove any previous override classes
				cell.classList.remove('!hidden', '!table-cell');
				
				// Apply override if set
				if (override === 'show') {
					// User wants this column always visible
					cell.classList.add('!table-cell');
				} else if (override === 'hide') {
					// User wants this column always hidden
					cell.classList.add('!hidden');
				}
				// If override is null, responsive classes work naturally
			});
		});
		
		updateColumnSelectorUI();
	}

	function updateColumnSelectorUI() {
		const container = document.getElementById('columnSelectorOptions');
		if (!container) return;

		container.innerHTML = '';

		columns.forEach(col => {
			// Check actual visibility - find a header cell with this column-id
			const headerCell = document.querySelector(`th[data-column-id="${col.id}"]`) as HTMLElement;
			const isActuallyVisible = headerCell ? isElementVisible(headerCell) : true;
			
			const itemDiv = document.createElement('div');
			itemDiv.className = 'flex items-center gap-2 py-1.5 px-2 rounded hover:bg-muted/50';
			
			const checkbox = document.createElement('input');
			checkbox.type = 'checkbox';
			checkbox.id = `col-${col.id}`;
			// Show checkbox as checked if column is currently visible
			checkbox.checked = isActuallyVisible;
			checkbox.disabled = col.alwaysVisible || false;
			checkbox.className = col.alwaysVisible ? 'cursor-not-allowed' : 'cursor-pointer';
			checkbox.addEventListener('change', (e) => {
				toggleColumn(col.id, (e.target as HTMLInputElement).checked);
			});
			
			const label = document.createElement('label');
			label.htmlFor = `col-${col.id}`;
			label.textContent = col.label;
			label.className = `flex-1 text-sm ${col.alwaysVisible ? 'text-muted-foreground' : 'cursor-pointer'}`;
			
			itemDiv.appendChild(checkbox);
			itemDiv.appendChild(label);
			container.appendChild(itemDiv);
		});
	}

	// Helper function to check if element is actually visible
	function isElementVisible(element: HTMLElement): boolean {
		// Check if element has display: none or visibility: hidden
		const style = window.getComputedStyle(element);
		if (style.display === 'none' || style.visibility === 'hidden') {
			return false;
		}
		
		// Check if element has offsetParent (elements with display:none don't have one)
		// Note: fixed position elements don't have offsetParent even if visible
		if (element.offsetParent === null && style.position !== 'fixed') {
			return false;
		}
		
		return true;
	}

	function showAllColumns() {
		columns.forEach(col => {
			columnVisibility[col.id] = true;
			columnOverrides[col.id] = 'show'; // Override to always show
		});
		saveColumnVisibility();
		applyColumnVisibility();
	}

	function resetColumns() {
		columns.forEach(col => {
			columnVisibility[col.id] = true;
			columnOverrides[col.id] = null; // Clear overrides - let responsive work
		});
		saveColumnVisibility();
		applyColumnVisibility();
	}

	// Update dropdown options based on current filter selections
	function updateDropdownOptions() {
		if (!filterMapping) return;

		const currentTeams = currentFilters.teams;
		const currentLeagues = currentFilters.leagues;
		const currentSeasons = currentFilters.seasons;

		// Always show all available options
		const availableTeams = filterMapping.all?.teams || [];
		const availableLeagues = filterMapping.all?.leagues || [];
		const availableSeasons = filterMapping.all?.seasons || [];

		// Calculate valid options based on current selections
		const validTeams = getValidOptions('team', currentLeagues, currentSeasons);
		const validLeagues = getValidOptions('league', currentTeams, currentSeasons);
		const validSeasons = getValidOptions('season', currentTeams, currentLeagues);

		// Render the options with valid ones highlighted
		renderFilterOptions('team', availableTeams, currentTeams, validTeams);
		renderFilterOptions('league', availableLeagues, currentLeagues, validLeagues);
		renderFilterOptions('season', availableSeasons.map(String), currentSeasons, validSeasons.map(String));

		// Update button labels
		updateFilterButtonLabel('team', currentTeams);
		updateFilterButtonLabel('league', currentLeagues);
		updateFilterButtonLabel('season', currentSeasons);
	}

	// Get valid options for a filter based on other filter selections
	function getValidOptions(targetFilter: string, otherFilter1: string[], otherFilter2: string[]): string[] {
		if (!filterMapping) return [];

		// If no filters are selected, all options are valid
		if (otherFilter1.length === 0 && otherFilter2.length === 0) {
			if (targetFilter === 'team') return filterMapping.all?.teams || [];
			if (targetFilter === 'league') return filterMapping.all?.leagues || [];
			if (targetFilter === 'season') return filterMapping.all?.seasons || [];
			return [];
		}

		const validSet = new Set<string>();

		if (targetFilter === 'team') {
			// Calculate valid teams based on selected leagues and seasons
			const leagues = otherFilter1; // currentLeagues
			const seasons = otherFilter2; // currentSeasons

			if (leagues.length === 0 && seasons.length > 0) {
				// Only seasons selected - get teams from bySeason
				seasons.forEach(season => {
					const teams = filterMapping.bySeason?.[season]?.teams;
					if (teams) teams.forEach(t => validSet.add(t));
				});
			} else if (leagues.length > 0 && seasons.length === 0) {
				// Only leagues selected - get teams from byLeague
				leagues.forEach(league => {
					const teams = filterMapping.byLeague?.[league]?.teams;
					if (teams) teams.forEach(t => validSet.add(t));
				});
			} else {
				// Both selected - get intersection
				seasons.forEach(season => {
					leagues.forEach(league => {
						const key = `${season}:${league}`;
						const teams = filterMapping.combinations?.seasonLeague?.[key];
						if (teams) teams.forEach(t => validSet.add(t));
					});
				});
			}
		} else if (targetFilter === 'league') {
			// Calculate valid leagues based on selected teams and seasons
			const teams = otherFilter1; // currentTeams
			const seasons = otherFilter2; // currentSeasons

			if (teams.length === 0 && seasons.length > 0) {
				// Only seasons selected - get leagues from bySeason
				seasons.forEach(season => {
					const leagues = filterMapping.bySeason?.[season]?.leagues;
					if (leagues) leagues.forEach(l => validSet.add(l));
				});
			} else if (teams.length > 0 && seasons.length === 0) {
				// Only teams selected - get leagues from byTeam
				teams.forEach(team => {
					const leagues = filterMapping.byTeam?.[team]?.leagues;
					if (leagues) leagues.forEach(l => validSet.add(l));
				});
			} else {
				// Both selected - get intersection
				teams.forEach(team => {
					seasons.forEach(season => {
						const key = `${team}:${season}`;
						const leagues = filterMapping.combinations?.teamSeason?.[key];
						if (leagues) leagues.forEach(l => validSet.add(l));
					});
				});
			}
		} else if (targetFilter === 'season') {
			// Calculate valid seasons based on selected teams and leagues
			const teams = otherFilter1; // currentTeams
			const leagues = otherFilter2; // currentLeagues

			if (teams.length === 0 && leagues.length > 0) {
				// Only leagues selected - get seasons from byLeague
				leagues.forEach(league => {
					const seasons = filterMapping.byLeague?.[league]?.seasons;
					if (seasons) seasons.forEach(s => validSet.add(s));
				});
			} else if (teams.length > 0 && leagues.length === 0) {
				// Only teams selected - get seasons from byTeam
				teams.forEach(team => {
					const seasons = filterMapping.byTeam?.[team]?.seasons;
					if (seasons) seasons.forEach(s => validSet.add(s));
				});
			} else {
				// Both selected - get intersection
				teams.forEach(team => {
					leagues.forEach(league => {
						const key = `${team}:${league}`;
						const seasons = filterMapping.combinations?.teamLeague?.[key];
						if (seasons) seasons.forEach(s => validSet.add(s));
					});
				});
			}
		}

		return Array.from(validSet);
	}

	// Render filter options with checkboxes and links
	function renderFilterOptions(filterType: string, options: string[], selectedValues: string[], validOptions: string[]) {
		const container = document.getElementById(`${filterType}FilterOptions`);
		if (!container) return;

		container.innerHTML = '';

		options.forEach(option => {
			const isChecked = selectedValues.includes(option);
			const isValid = validOptions.includes(option);
			
			const itemDiv = document.createElement('div');
			itemDiv.className = `flex items-center gap-2 py-1 rounded px-1 ${isValid ? 'hover:bg-muted/50' : 'opacity-40'}`;
			
			// Checkbox
			const checkbox = document.createElement('input');
			checkbox.type = 'checkbox';
			checkbox.id = `${filterType}-${option}`;
			checkbox.value = option;
			checkbox.checked = isChecked;
			checkbox.className = isValid ? 'cursor-pointer' : 'cursor-not-allowed';
			checkbox.addEventListener('change', (e) => {
				handleCheckboxChange(filterType, option, (e.target as HTMLInputElement).checked);
			});
			
			// Link label
			const link = document.createElement('a');
			link.href = '#';
			link.textContent = option;
			link.className = `flex-1 text-sm ${isValid ? 'hover:underline cursor-pointer' : 'cursor-not-allowed'}`;
			link.addEventListener('click', (e) => {
				e.preventDefault();
				if (isValid) {
					handleLinkClick(filterType, option);
				}
			});
			
			itemDiv.appendChild(checkbox);
			itemDiv.appendChild(link);
			container.appendChild(itemDiv);
		});
	}

	// Update filter button label to show selected count
	function updateFilterButtonLabel(filterType: string, selectedValues: string[]) {
		const label = document.getElementById(`${filterType}FilterLabel`);
		if (!label) return;

		const filterName = filterType.charAt(0).toUpperCase() + filterType.slice(1) + 's';
		
		if (selectedValues.length === 0) {
			label.textContent = filterName;
		} else if (selectedValues.length === 1) {
			label.textContent = selectedValues[0];
		} else {
			label.textContent = `${filterName} (${selectedValues.length})`;
		}
		
		// Update clear button state
		const clearBtn = document.getElementById(`${filterType}ClearBtn`) as HTMLButtonElement;
		if (clearBtn) {
			clearBtn.disabled = selectedValues.length === 0;
		}
	}

	// Handle checkbox change
	function handleCheckboxChange(filterType: string, value: string, checked: boolean) {
		const filterKey = `${filterType}s` as 'teams' | 'leagues' | 'seasons';
		
		if (checked) {
			if (!currentFilters[filterKey].includes(value)) {
				currentFilters[filterKey].push(value);
			}
		} else {
			currentFilters[filterKey] = currentFilters[filterKey].filter(v => v !== value);
		}
		
		updateFilterButtonLabel(filterType, currentFilters[filterKey]);
		updateDropdownOptions();
		updateHeatsRange(); // Update heats range when other filters change
		updateURL();
		applyFiltersAndSort();
	}

	// Handle link click (select only this item)
	function handleLinkClick(filterType: string, value: string) {
		const filterKey = `${filterType}s` as 'teams' | 'leagues' | 'seasons';
		currentFilters[filterKey] = [value];
		
		// Close the dropdown
		const dropdown = document.getElementById(`${filterType}FilterDropdown`);
		if (dropdown) {
			dropdown.classList.add('hidden');
		}
		
		updateFilterButtonLabel(filterType, currentFilters[filterKey]);
		updateDropdownOptions();
		updateHeatsRange(); // Update heats range when other filters change
		updateURL();
		applyFiltersAndSort();
	}

	// Check if cached data is a superset of requested filters
	// Returns the cached data if it contains all rows we need, null otherwise
	function findSupersetInCache(): any[] | null {
		const target = {
			teams: currentFilters.teams,
			leagues: currentFilters.leagues,
			seasons: currentFilters.seasons
		};

		// Check for exact match first
		const exactKey = getCacheKey(target.teams, target.leagues, target.seasons);
		if (dataCache.has(exactKey)) {
			return dataCache.get(exactKey)!;
		}

		// Check all cached entries for a superset
		for (const [key, data] of dataCache.entries()) {
			// Parse the cache key to get cached filter values
			const [teamsStr, leaguesStr, seasonsStr] = key.split(':');
			const cachedTeams = teamsStr ? teamsStr.split(',') : [];
			const cachedLeagues = leaguesStr ? leaguesStr.split(',') : [];
			const cachedSeasons = seasonsStr ? seasonsStr.split(',') : [];

			// Check if cached data is a superset of what we need
			// Cached is superset if:
			// - For each filter dimension, cached is either empty (all data) OR contains all target values
			// - If target wants all data (empty), cached must also be all data (empty)
			const isTeamSuperset = cachedTeams.length === 0 || 
				(target.teams.length > 0 && target.teams.every(t => cachedTeams.includes(t)));
			const isLeagueSuperset = cachedLeagues.length === 0 || 
				(target.leagues.length > 0 && target.leagues.every(l => cachedLeagues.includes(l)));
			const isSeasonSuperset = cachedSeasons.length === 0 || 
				(target.seasons.length > 0 && target.seasons.every(s => cachedSeasons.includes(s)));

			if (isTeamSuperset && isLeagueSuperset && isSeasonSuperset) {
				return data;
			}
		}

		return null;
	}

	// Initialize from URL params
	function initializeFromURL() {
		const urlParams = new URLSearchParams(window.location.search);
		currentFilters.search = urlParams.get('search') || '';
		currentFilters.teams = urlParams.get('team')?.split(',').filter(Boolean) || [];
		currentFilters.leagues = urlParams.get('league')?.split(',').filter(Boolean) || [];
		currentFilters.seasons = urlParams.get('season')?.split(',').filter(Boolean) || [];
		currentFilters.heatsMin = urlParams.get('heatsMin') ? parseInt(urlParams.get('heatsMin')!) : null;
		currentFilters.heatsMax = urlParams.get('heatsMax') ? parseInt(urlParams.get('heatsMax')!) : null;
		
		// Parse sort columns from URL (format: sortColumn=col1,col2&sortDirection=desc,asc)
		const sortColumns = urlParams.get('sortColumn')?.split(',').filter(Boolean) || [];
		const sortDirections = urlParams.get('sortDirection')?.split(',').filter(Boolean) || [];
		currentFilters.sortColumns = sortColumns.map((col, idx) => ({
			column: col,
			direction: sortDirections[idx] || 'desc'
		}));

		// Get initial heats range from window
		const initialHeatsMin = (window as any).__INITIAL_HEATS_MIN__;
		const initialHeatsMax = (window as any).__INITIAL_HEATS_MAX__;
		if (initialHeatsMin !== null) currentFilters.heatsMin = initialHeatsMin;
		if (initialHeatsMax !== null) currentFilters.heatsMax = initialHeatsMax;

		// Get initial data from window and cache it
		if ((window as any).__INITIAL_STATS__) {
			const initialData = (window as any).__INITIAL_STATS__;
			const initialTeams = (window as any).__INITIAL_TEAMS__ || [];
			const initialLeagues = (window as any).__INITIAL_LEAGUES__ || [];
			const initialSeasons = (window as any).__INITIAL_SEASONS__ || [];
			
			// Add original index to preserve order
			const indexedData = initialData.map((item: any, index: number) => ({ ...item, __originalIndex: index }));
			
			const cacheKey = getCacheKey(initialTeams, initialLeagues, initialSeasons);
			dataCache.set(cacheKey, indexedData);
			
			// If we loaded all data, set totalDataCount
			if ((window as any).__HAS_ALL_DATA__) {
				totalDataCount = initialData.length;
			}
		}

		// Initialize heats range from filter mapping
		if (filterMapping?.heatsRange) {
			heatsRangeMin = filterMapping.heatsRange.min || 0;
			heatsRangeMax = filterMapping.heatsRange.max || 100;
		}

		// Update sort indicators if sorting is active
		if (currentFilters.sortColumns.length > 0) {
			updateSortIndicators();
		}
	}

	// Update URL with current filter state
	function updateURL() {
		const params = new URLSearchParams();
		if (currentFilters.search) params.set('search', currentFilters.search);
		if (currentFilters.teams.length > 0) params.set('team', currentFilters.teams.join(','));
		if (currentFilters.leagues.length > 0) params.set('league', currentFilters.leagues.join(','));
		if (currentFilters.seasons.length > 0) params.set('season', currentFilters.seasons.join(','));
		if (currentFilters.heatsMin !== null) params.set('heatsMin', currentFilters.heatsMin.toString());
		if (currentFilters.heatsMax !== null) params.set('heatsMax', currentFilters.heatsMax.toString());
		if (currentFilters.sortColumns.length > 0) {
			params.set('sortColumn', currentFilters.sortColumns.map(s => s.column).join(','));
			params.set('sortDirection', currentFilters.sortColumns.map(s => s.direction).join(','));
		}

		const newURL = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
		window.history.pushState({}, '', newURL);
	}

	// Initialize
	document.addEventListener('DOMContentLoaded', () => {
		// Initialize state from URL
		initializeFromURL();

		// Initialize column visibility
		loadColumnVisibility();
		applyColumnVisibility();

		// Initialize dropdown options
		updateDropdownOptions();

		// Setup search with debounce
		const searchInput = document.getElementById('searchInput') as HTMLInputElement;
		searchInput?.addEventListener('input', (e) => {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(() => {
				currentFilters.search = (e.target as HTMLInputElement).value;
				updateURL();
				applyFiltersAndSort();
			}, 300);
		});

		// Setup filter dropdown toggles
		const teamFilterBtn = document.getElementById('teamFilterBtn');
		const leagueFilterBtn = document.getElementById('leagueFilterBtn');
		const seasonFilterBtn = document.getElementById('seasonFilterBtn');
		const heatsFilterBtn = document.getElementById('heatsFilterBtn');
		const columnSelectorBtn = document.getElementById('columnSelectorBtn');

		teamFilterBtn?.addEventListener('click', () => toggleDropdown('team'));
		leagueFilterBtn?.addEventListener('click', () => toggleDropdown('league'));
		seasonFilterBtn?.addEventListener('click', () => toggleDropdown('season'));
		heatsFilterBtn?.addEventListener('click', () => toggleDropdown('heats'));
		columnSelectorBtn?.addEventListener('click', () => toggleDropdown('column'));

		// Close dropdowns when clicking outside
		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (!target.closest('.relative')) {
				closeAllDropdowns();
			}
		});

		// Setup clear buttons
		document.querySelectorAll('[data-action="clear"]').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const filterType = (btn as HTMLElement).dataset.filter;
				if (filterType) handleClear(filterType);
			});
		});

		// Setup column selector buttons
		const showAllBtn = document.getElementById('showAllColumns');
		const resetBtn = document.getElementById('resetColumns');
		showAllBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			showAllColumns();
		});
		resetBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			resetColumns();
		});

		// Setup heats slider
		initializeHeatsSlider();
		const heatsClearBtn = document.getElementById('heatsClearBtn');
		heatsClearBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			handleHeatsClear();
		});

		// Setup sorting
		const sortableHeaders = document.querySelectorAll('.sortable');
		sortableHeaders.forEach(header => {
			header.addEventListener('click', handleSort);
		});

		// Update column selector UI on window resize (for responsive visibility changes)
		let resizeTimer: number;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => {
				// Only update if dropdown is open
				const dropdown = document.getElementById('columnSelectorDropdown');
				if (dropdown && !dropdown.classList.contains('hidden')) {
					updateColumnSelectorUI();
				}
			}, 150); // Debounce resize events
		});
	});

	// Toggle dropdown visibility
	function toggleDropdown(filterType: string) {
		const dropdown = document.getElementById(`${filterType === 'column' ? 'columnSelector' : filterType + 'Filter'}Dropdown`);
		if (!dropdown) return;

		const isHidden = dropdown.classList.contains('hidden');
		
		// Close all dropdowns first
		closeAllDropdowns();
		
		// Toggle this dropdown
		if (isHidden) {
			dropdown.classList.remove('hidden');
			
			// Position column selector dropdown intelligently
			if (filterType === 'column') {
				positionColumnDropdown(dropdown);
				// Update column selector UI when opening to reflect current visibility
				updateColumnSelectorUI();
			}
		}
	}

	// Position column dropdown to stay within viewport
	function positionColumnDropdown(dropdown: HTMLElement) {
		// Reset positioning classes to defaults
		dropdown.classList.remove('right-0', 'left-0', 'bottom-full', 'mb-1');
		dropdown.classList.add('mt-1');
		
		// Force a reflow to get accurate measurements
		dropdown.offsetHeight;
		
		// Get dropdown and viewport dimensions
		const rect = dropdown.getBoundingClientRect();
		const button = document.getElementById('columnSelectorBtn');
		const buttonRect = button?.getBoundingClientRect();
		const viewportWidth = window.innerWidth;
		const viewportHeight = window.innerHeight;
		
		// Default: align to right of button (since it's on the right side)
		dropdown.classList.add('right-0');
		
		// Check horizontal overflow after right alignment
		dropdown.offsetHeight; // Force reflow
		const rectRightAligned = dropdown.getBoundingClientRect();
		
		if (rectRightAligned.left < 0) {
			// Overflowing on left, switch to left alignment
			dropdown.classList.remove('right-0');
			dropdown.classList.add('left-0');
		}
		
		// Check vertical overflow
		dropdown.offsetHeight; // Force reflow
		const rectFinal = dropdown.getBoundingClientRect();
		
		if (rectFinal.bottom > viewportHeight - 20) { // 20px padding
			// Not enough space below, position above
			dropdown.classList.remove('mt-1');
			dropdown.classList.add('bottom-full', 'mb-1');
		}
	}

	// Close all dropdowns
	function closeAllDropdowns() {
		document.getElementById('teamFilterDropdown')?.classList.add('hidden');
		document.getElementById('leagueFilterDropdown')?.classList.add('hidden');
		document.getElementById('seasonFilterDropdown')?.classList.add('hidden');
		document.getElementById('heatsFilterDropdown')?.classList.add('hidden');
		document.getElementById('columnSelectorDropdown')?.classList.add('hidden');
	}

	// Initialize heats slider
	function initializeHeatsSlider() {
		updateHeatsSlider();
		
		const minIndicator = document.getElementById('heatsMinIndicator');
		const maxIndicator = document.getElementById('heatsMaxIndicator');
		const sliderContainer = minIndicator?.parentElement;
		
		if (!minIndicator || !maxIndicator || !sliderContainer) return;

		// Mouse/touch event handlers for min indicator
		const startDragMin = (e: MouseEvent | TouchEvent) => {
			e.preventDefault();
			isDraggingMin = true;
			document.body.style.cursor = 'grabbing';
		};

		minIndicator.addEventListener('mousedown', startDragMin);
		minIndicator.addEventListener('touchstart', startDragMin);

		// Mouse/touch event handlers for max indicator
		const startDragMax = (e: MouseEvent | TouchEvent) => {
			e.preventDefault();
			isDraggingMax = true;
			document.body.style.cursor = 'grabbing';
		};

		maxIndicator.addEventListener('mousedown', startDragMax);
		maxIndicator.addEventListener('touchstart', startDragMax);

		// Global mouse/touch move handler
		const handleMove = (e: MouseEvent | TouchEvent) => {
			if (!isDraggingMin && !isDraggingMax) return;
			
			const rect = sliderContainer.getBoundingClientRect();
			const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
			const relativeY = clientY - rect.top;
			const percentage = Math.max(0, Math.min(100, (relativeY / rect.height) * 100));
			
			// Convert percentage to heats value (inverted because top = max)
			const value = Math.round(heatsRangeMax - (percentage / 100) * (heatsRangeMax - heatsRangeMin));
			
			if (isDraggingMin) {
				// Ensure min doesn't go above max
				const maxValue = currentFilters.heatsMax ?? heatsRangeMax;
				currentFilters.heatsMin = Math.min(value, maxValue);
			} else if (isDraggingMax) {
				// Ensure max doesn't go below min
				const minValue = currentFilters.heatsMin ?? heatsRangeMin;
				currentFilters.heatsMax = Math.max(value, minValue);
			}
			
			updateHeatsSlider();
		};

		// Global mouse/touch up handler
		const stopDrag = () => {
			if (isDraggingMin || isDraggingMax) {
				isDraggingMin = false;
				isDraggingMax = false;
				document.body.style.cursor = '';
				
				// Apply filter when drag stops
				updateURL();
				applyFiltersAndSort();
			}
		};

		document.addEventListener('mousemove', handleMove);
		document.addEventListener('touchmove', handleMove);
		document.addEventListener('mouseup', stopDrag);
		document.addEventListener('touchend', stopDrag);
	}

	// Update heats slider positions and labels
	function updateHeatsSlider() {
		const minIndicator = document.getElementById('heatsMinIndicator');
		const maxIndicator = document.getElementById('heatsMaxIndicator');
		const minLabel = document.getElementById('heatsMinLabel');
		const maxLabel = document.getElementById('heatsMaxLabel');
		const filterLabel = document.getElementById('heatsFilterLabel');
		const clearBtn = document.getElementById('heatsClearBtn') as HTMLButtonElement;
		const tickLabels = document.getElementById('heatsTickLabels');
		const tickMarks = document.getElementById('heatsTickMarks');
		
		if (!minIndicator || !maxIndicator || !minLabel || !maxLabel) return;

		// Update range display
		const range = heatsRangeMax - heatsRangeMin;
		const minValue = currentFilters.heatsMin ?? heatsRangeMin;
		const maxValue = currentFilters.heatsMax ?? heatsRangeMax;
		
		// Calculate positions (inverted: top = max, bottom = min)
		const minPercentage = ((heatsRangeMax - minValue) / range) * 100;
		const maxPercentage = ((heatsRangeMax - maxValue) / range) * 100;
		
		minIndicator.style.top = `${minPercentage}%`;
		maxIndicator.style.top = `${maxPercentage}%`;
		
		minLabel.textContent = minValue.toString();
		maxLabel.textContent = maxValue.toString();
		
		// Generate tick marks dynamically
		if (tickLabels && tickMarks) {
			// Generate reasonable tick values
			const tickValues = generateTickValues(heatsRangeMin, heatsRangeMax);
			
			// Clear existing ticks
			tickLabels.innerHTML = '';
			tickMarks.innerHTML = '';
			
			// Create tick marks and labels
			tickValues.forEach(value => {
				const percentage = ((heatsRangeMax - value) / range) * 100;
				
				// Create label
				const label = document.createElement('span');
				label.className = 'absolute block text-right leading-none';
				label.style.top = `${percentage}%`;
				label.style.transform = 'translateY(-50%)';
				label.textContent = value.toString();
				tickLabels.appendChild(label);
				
				// Create tick mark
				const isEndpoint = value === heatsRangeMin || value === heatsRangeMax;
				const tick = document.createElement('div');
				tick.className = `absolute left-1/2 h-[2px] -translate-x-1/2 ${isEndpoint ? 'w-[8px] bg-foreground/30' : 'w-[6px] bg-foreground/20'}`;
				tick.style.top = `${percentage}%`;
				tickMarks.appendChild(tick);
			});
		}
		
		// Update filter label
		if (filterLabel) {
			if (currentFilters.heatsMin !== null || currentFilters.heatsMax !== null) {
				if (currentFilters.heatsMin !== null && currentFilters.heatsMax !== null) {
					filterLabel.textContent = `${minValue}-${maxValue}`;
				} else if (currentFilters.heatsMin !== null) {
					filterLabel.textContent = `≥${minValue}`;
				} else {
					filterLabel.textContent = `≤${maxValue}`;
				}
			} else {
				filterLabel.textContent = 'Heats';
			}
		}
		
		// Update clear button state
		if (clearBtn) {
			clearBtn.disabled = currentFilters.heatsMin === null && currentFilters.heatsMax === null;
		}
	}

	// Generate reasonable tick values for the slider
	function generateTickValues(min: number, max: number): number[] {
		const ticks: number[] = [];
		
		// Always include min
		ticks.push(min);
		
		// Standard tick values: 10, 25, 50, 75, 100, then continue with 25 increments
		const standardTicks = [10, 25, 50, 75, 100];
		
		// Add standard ticks that fall within range
		standardTicks.forEach(value => {
			if (value > min && value < max) {
				ticks.push(value);
			}
		});
		
		// If max is greater than 100, continue with 25 increments
		if (max > 100) {
			for (let value = 125; value < max; value += 25) {
				if (value > min && value < max) {
					ticks.push(value);
				}
			}
		}
		
		// Always include max if it's different from min
		if (max !== min) {
			ticks.push(max);
		}
		
		// Sort and return unique values
		return [...new Set(ticks)].sort((a, b) => a - b);
	}

	// Handle heats clear
	function handleHeatsClear() {
		currentFilters.heatsMin = null;
		currentFilters.heatsMax = null;
		updateHeatsSlider();
		updateURL();
		applyFiltersAndSort();
	}

	// Handle clear (deselect all items)
	function handleClear(filterType: string) {
		const filterKey = `${filterType}s` as 'teams' | 'leagues' | 'seasons';
		const container = document.getElementById(`${filterType}FilterOptions`);
		if (!container) return;

		// Get all checkboxes and uncheck them
		const checkboxes = container.querySelectorAll('input[type="checkbox"]') as NodeListOf<HTMLInputElement>;
		
		checkboxes.forEach(checkbox => {
			checkbox.checked = false;
		});

		currentFilters[filterKey] = [];
		updateFilterButtonLabel(filterType, []);
		updateDropdownOptions();
		updateHeatsRange(); // Update heats range when other filters change
		updateURL();
		applyFiltersAndSort();
	}

	// Update heats range based on current filters (excluding heats itself)
	async function updateHeatsRange() {
		// Build query string for filters (excluding heats)
		const params = new URLSearchParams();
		if (currentFilters.teams.length > 0) params.set('team', currentFilters.teams.join(','));
		if (currentFilters.leagues.length > 0) params.set('league', currentFilters.leagues.join(','));
		if (currentFilters.seasons.length > 0) params.set('season', currentFilters.seasons.join(','));

		try {
			const response = await fetch(`/api/sel/stats/filters?${params.toString()}`);
			if (!response.ok) {
				throw new Error('Failed to fetch filters');
			}

			const data = await response.json();
			if (data.heatsRange) {
				heatsRangeMin = data.heatsRange.min || 0;
				heatsRangeMax = data.heatsRange.max || 100;
				
				// Adjust current heats filter if it's outside the new range
				if (currentFilters.heatsMin !== null && currentFilters.heatsMin < heatsRangeMin) {
					currentFilters.heatsMin = heatsRangeMin;
				}
				if (currentFilters.heatsMax !== null && currentFilters.heatsMax > heatsRangeMax) {
					currentFilters.heatsMax = heatsRangeMax;
				}
				
				updateHeatsSlider();
			}
		} catch (error) {
			console.error('Error fetching heats range:', error);
		}
	}

	async function applyFiltersAndSort() {
		// Check if we have cached data that contains what we need
		const cachedData = findSupersetInCache();

		if (cachedData) {
			// Use cached data - filter and sort client-side
			filterAndSortClientSide(cachedData);
		} else {
			// Fetch from API and cache the result
			await fetchStats();
		}
	}

	function filterAndSortClientSide(sourceData: any[]) {
		// Use data as-is (already has __originalIndex from caching)
		let filteredData = sourceData;

		// Apply team filter (client-side) - handle split teams like TAR/GOR
		if (currentFilters.teams.length > 0) {
			filteredData = filteredData.filter(stat => {
				const teamParts = stat.Team.split('/').map((t: string) => t.trim());
				return teamParts.some((team: string) => currentFilters.teams.includes(team));
			});
		}

		// Apply league filter (client-side)
		if (currentFilters.leagues.length > 0) {
			filteredData = filteredData.filter(stat => currentFilters.leagues.includes(stat.League));
		}

		// Apply season filter (client-side)
		if (currentFilters.seasons.length > 0) {
			filteredData = filteredData.filter(stat => 
				currentFilters.seasons.includes(stat.Season.toString())
			);
		}

		// Apply heats filter (client-side)
		if (currentFilters.heatsMin !== null || currentFilters.heatsMax !== null) {
			filteredData = filteredData.filter(stat => {
				const heats = stat.Heats || 0;
				const minCheck = currentFilters.heatsMin === null || heats >= currentFilters.heatsMin;
				const maxCheck = currentFilters.heatsMax === null || heats <= currentFilters.heatsMax;
				return minCheck && maxCheck;
			});
		}

		// Apply search filter (client-side)
		if (currentFilters.search) {
			const searchLower = currentFilters.search.toLowerCase();
			filteredData = filteredData.filter(stat => 
				stat.Name.toLowerCase().includes(searchLower)
			);
		}

		// Apply sorting
		if (currentFilters.sortColumns.length > 0) {
			// Columns where empty values should go to bottom
			const specialEmptyHandling = ['Average', 'Home Avg.', 'Away Avg.', 'Max Speed'];

			filteredData.sort((a: any, b: any) => {
				// Try each sort column in order until we find a difference
				for (const { column, direction: dir } of currentFilters.sortColumns) {
					const direction = dir === 'asc' ? 1 : -1;
					const aVal = a[column];
					const bVal = b[column];
					const shouldHandleEmpty = specialEmptyHandling.includes(column);

					// Special handling for Average/Home/Away/Max Speed columns
					if (shouldHandleEmpty) {
						const aIsEmpty = !aVal || aVal === '-';
						const bIsEmpty = !bVal || bVal === '-';

						// Handle empty values - always at bottom
						if (aIsEmpty && bIsEmpty) continue; // Try next column
						if (aIsEmpty) return 1;
						if (bIsEmpty) return -1;
					}

					// Compare values
					let result = 0;
					if (typeof aVal === 'string') {
						result = direction * aVal.localeCompare(bVal);
					} else {
						result = direction * (aVal - bVal);
					}

					// If values are different, return the result
					if (result !== 0) return result;
					// Otherwise continue to next sort column
				}
				return 0; // All sort columns were equal
			});
		} else {
			// No sort - maintain original order but keep empty Average values at bottom
			filteredData.sort((a: any, b: any) => {
				const aAvgEmpty = !a.Average || a.Average === '-';
				const bAvgEmpty = !b.Average || b.Average === '-';
				
				if (aAvgEmpty) return bAvgEmpty ? a.__originalIndex - b.__originalIndex : 1;
				if (bAvgEmpty) return -1;
				
				return a.__originalIndex - b.__originalIndex;
			});
		}

		// Update table with filtered/sorted data
		updateTable(filteredData);
	}

	async function fetchStats() {
		if (isLoading) return;
		isLoading = true;

		// Build query string (excluding search - that's client-side only)
		const params = new URLSearchParams();
		if (currentFilters.teams.length > 0) params.set('team', currentFilters.teams.join(','));
		if (currentFilters.leagues.length > 0) params.set('league', currentFilters.leagues.join(','));
		if (currentFilters.seasons.length > 0) params.set('season', currentFilters.seasons.join(','));
		// Note: We don't send search, sortColumn, sortDirection to API
		// Those will be applied client-side

		try {
			const response = await fetch(`/api/sel/stats?${params.toString()}`);
			if (!response.ok) {
				throw new Error('Failed to fetch stats');
			}

			const data = await response.json();
			
			// Add original index to preserve order
			const indexedData = data.stats.map((item: any, index: number) => ({ ...item, __originalIndex: index }));
			
			// Cache the fetched data
			const cacheKey = getCacheKey(currentFilters.teams, currentFilters.leagues, currentFilters.seasons);
			dataCache.set(cacheKey, indexedData);
			
			// If this is all data (no filters), update totalDataCount
			if (currentFilters.teams.length === 0 && currentFilters.leagues.length === 0 && currentFilters.seasons.length === 0) {
				totalDataCount = data.stats.length;
			}
			
			// Now apply search and sort client-side
			filterAndSortClientSide(indexedData);
		} catch (error) {
			console.error('Error fetching stats:', error);
		} finally {
			isLoading = false;
		}
	}

	function updateTable(stats: any[]) {
		const tbody = document.getElementById('statsBody');
		if (!tbody) return;

		// Use DocumentFragment for batch DOM operations
		const fragment = document.createDocumentFragment();

		// Build all rows in memory first
		stats.forEach((stat: any, index: number) => {
			const row = document.createElement('tr');
			row.className = 'border-t border-border hover:bg-muted/50';
			row.innerHTML = `
				<td class="px-2 py-2 text-right text-muted-foreground" data-column-id="rank">${index + 1}</td>
				<td class="px-3 py-2 text-left font-medium" data-column-id="name">${stat.Name || ''}</td>
				<td class="px-3 py-2 text-left" data-column-id="team">${stat.Team || ''}</td>
				<td class="px-3 py-2 text-right" data-column-id="average">${stat.Average ? stat.Average.toFixed(3) : '-'}</td>
				<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="match">${stat.Match || 0}</td>
				<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="heats">${stat.Heats || 0}</td>
				<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="points">${stat.Points || 0}</td>
				<td class="px-3 py-2 text-right max-lg:hidden" data-column-id="bonus">${stat.Bonus || 0}</td>
				<td class="px-3 py-2 text-right max-sm:hidden" data-column-id="home">${stat['Home Avg.'] ? stat['Home Avg.'].toFixed(3) : '-'}</td>
				<td class="px-3 py-2 text-right max-sm:hidden" data-column-id="away">${stat['Away Avg.'] ? stat['Away Avg.'].toFixed(3) : '-'}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="i">${stat.I || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="ii">${stat.II || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="iii">${stat.III || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="iv">${stat.IV || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="r">${stat.R || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="t">${stat.T || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="m">${stat.M || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="x">${stat.X || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="f">${stat.F || 0}</td>
				<td class="px-3 py-2 text-right max-xl:hidden" data-column-id="warn">${stat.Warn || 0}</td>
				<td class="px-3 py-2 text-right max-md:hidden" data-column-id="maxspeed">${stat['Max Speed'] ? stat['Max Speed'].toFixed(2) : '-'}</td>
				<td class="px-3 py-2 text-left max-md:hidden" data-column-id="league">${stat.League || ''}</td>
				<td class="px-3 py-2 text-left max-md:hidden" data-column-id="season">${stat.Season || ''}</td>
			`;
			fragment.appendChild(row);
		});

		// Single DOM update
		tbody.innerHTML = '';
		tbody.appendChild(fragment);
		
		// Reapply column visibility after updating table
		applyColumnVisibility();
	}

	function updateSortIndicators() {
		// Clear all indicators
		document.querySelectorAll('.sort-indicator').forEach(indicator => {
			indicator.textContent = '';
		});

		// Set active indicators with priority numbers
		currentFilters.sortColumns.forEach((sort, index) => {
			const header = document.querySelector(`[data-column="${sort.column}"]`);
			const indicator = header?.querySelector('.sort-indicator');
			if (indicator) {
				const arrow = sort.direction === 'desc' ? '▼' : '▲';
				const priority = currentFilters.sortColumns.length > 1 ? `${index + 1}` : '';
				indicator.textContent = ` ${arrow}${priority}`;
			}
		});
	}

	function handleSort(event: Event) {
		const mouseEvent = event as MouseEvent;
		const header = event.currentTarget as HTMLElement;
		const column = header.dataset.column;
		if (!column) return;

		// Check if Shift key is pressed for multi-column sort
		if (mouseEvent.shiftKey) {
			// Multi-column sort: add/modify this column
			const existingIndex = currentFilters.sortColumns.findIndex(s => s.column === column);
			
			if (existingIndex >= 0) {
				// Column already in sort - toggle its direction or remove
				const current = currentFilters.sortColumns[existingIndex];
				if (current.direction === 'desc') {
					currentFilters.sortColumns[existingIndex].direction = 'asc';
				} else {
					// Remove this column from sort
					currentFilters.sortColumns.splice(existingIndex, 1);
				}
			} else {
				// Add new column to sort
				currentFilters.sortColumns.push({ column, direction: 'desc' });
			}
		} else {
			// Single column sort: replace all sorts with this one
			const existingIndex = currentFilters.sortColumns.findIndex(s => s.column === column);
			
			if (existingIndex === 0 && currentFilters.sortColumns.length === 1) {
				// Only this column is sorted - toggle direction or clear
				if (currentFilters.sortColumns[0].direction === 'desc') {
					currentFilters.sortColumns[0].direction = 'asc';
				} else {
					currentFilters.sortColumns = [];
				}
			} else {
				// Start new sort with this column
				currentFilters.sortColumns = [{ column, direction: 'desc' }];
			}
		}

		updateSortIndicators();
		updateURL();
		applyFiltersAndSort();
	}
</script>

