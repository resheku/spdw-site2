---
import Layout from '../../layouts/Layout.astro';
import TracksSection from '../../components/TracksSection.astro';

export const prerender = false;
---

<Layout title="SEL Tracks - spdw">
	<div class="p-4">
		<nav aria-label="breadcrumb">
			<ol
				class="text-muted-foreground flex flex-wrap items-center gap-1.5 text-sm break-words sm:gap-2.5"
			>
				<li class="inline-flex items-center gap-1.5">
					<a href="/" class="hover:text-foreground transition-colors">Home</a>
				</li>
				<li role="presentation" aria-hidden="true" class="[&>svg]:size-3.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
					>
				</li>
				<li class="inline-flex items-center gap-1.5">
					<a href="/sel" class="hover:text-foreground transition-colors">sel</a>
				</li>
				<li role="presentation" aria-hidden="true" class="[&>svg]:size-3.5">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
					>
				</li>
				<li class="inline-flex items-center gap-1.5">
					<span
						class="text-foreground font-normal"
						role="link"
						aria-disabled="true"
						aria-current="page">tracks</span
					>
				</li>
			</ol>
		</nav>
	</div>

	<div class="max-w-full px-4 pb-8">
		<h1 class="mb-6 text-2xl font-bold">Tracks</h1>

		<TracksSection />
	</div>
</Layout>
